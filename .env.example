# EduGenie Environment Configuration

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
# NEVER expose this key in frontend code or commit to source control.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000
